/* ===== LingoPlay 小程序全局样式（暗色科技 + 玻璃拟态） ===== */
page {
  background: #0a0f1e;
  color: #dbe4f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  min-height: 100%;
}

/* 页面容器 */
.page {
  padding: 24rpx 28rpx 60rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #dbe4f5;
  margin: 10rpx 0 6rpx;
}

.page-subtitle {
  color: #8a97b8;
  font-size: 26rpx;
  margin-bottom: 32rpx;
  display: block;
}

.text-muted {
  color: #8a97b8;
}

.text-sm {
  font-size: 24rpx;
}

/* 通用卡片（玻璃拟态） */
.card {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.18);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #dbe4f5;
  margin-bottom: 16rpx;
}

/* 玻璃拟态胶囊按钮 */
.glass-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.28), 0 12rpx 44rpx rgba(0, 0, 0, 0.28);
  margin-bottom: 20rpx;
}

.glass-btn:active {
  transform: scale(0.97);
}

.glass-btn.primary {
  background: linear-gradient(135deg, rgba(79, 124, 255, 0.5) 0%, rgba(34, 211, 238, 0.32) 100%);
  border-color: rgba(160, 200, 255, 0.35);
}

/* 主渐变大按钮 */
.play-btn {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-radius: 36rpx;
  padding: 36rpx 40rpx;
  color: #04122e;
  background: linear-gradient(135deg, #4f7cff 0%, #22d3ee 100%);
  box-shadow: 0 16rpx 64rpx rgba(79, 124, 255, 0.35);
}

.play-btn:active {
  transform: scale(0.98);
}

.play-btn .emoji {
  font-size: 64rpx;
}

.play-btn .title {
  font-size: 38rpx;
  font-weight: 800;
  display: block;
}

.play-btn .sub {
  font-size: 22rpx;
  opacity: 0.75;
  display: block;
  margin-top: 6rpx;
}

.play-btn .arrow {
  margin-left: auto;
  font-size: 40rpx;
  font-weight: 700;
}

/* 星级 */
.star {
  color: rgba(255, 255, 255, 0.14);
  font-size: 34rpx;
}

.star.on {
  color: #fbbf24;
  text-shadow: 0 0 36rpx rgba(251, 191, 36, 0.6);
}

.stars-row {
  display: flex;
  gap: 8rpx;
}

/* 返回上一级按钮 */
.back-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  border: 1rpx solid rgba(120, 150, 255, 0.22);
  color: #8a97b8;
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 34rpx;
  margin: 10rpx 0 24rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(120, 150, 255, 0.3);
  color: #a5b4fc;
  background: rgba(79, 124, 255, 0.12);
}

/* 输入框 */
.input {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(120, 150, 255, 0.22);
  border-radius: 20rpx;
  color: #dbe4f5;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

/* HUD 战况栏 */
.hud {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.hud-item {
  text-align: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.16);
  border-radius: 20rpx;
  padding: 12rpx 36rpx;
}

.hud-label {
  display: block;
  font-size: 20rpx;
  color: #8a97b8;
  margin-bottom: 4rpx;
}

.hud-value {
  font-size: 40rpx;
  font-weight: 800;
  color: #dbe4f5;
}

/* 空态 */
.empty-tip {
  color: #8a97b8;
  text-align: center;
  padding: 60rpx 0;
  font-size: 26rpx;
}

/* 分割线 */
.divider {
  border-top: 1rpx dashed rgba(120, 150, 255, 0.18);
  margin: 24rpx 0;
}

/* 网格 */
.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-2 > .cell {
  width: calc(50% - 10rpx);
}