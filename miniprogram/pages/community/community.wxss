.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.create-btn {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  color: #04122e;
  font-weight: 700;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
}

.lang-tabs {
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.lang-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 34rpx;
  font-size: 24rpx;
  color: #8a97b8;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
}

.lang-tab.active {
  color: #04122e;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
  border-color: transparent;
  font-weight: 700;
}

.post {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.post-avatar {
  font-size: 52rpx;
}

.post-author {
  font-weight: 600;
  font-size: 26rpx;
}

.post-lang {
  margin-left: auto;
}

.post-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.post-preview {
  color: #8a97b8;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.post-foot {
  display: flex;
  gap: 36rpx;
  color: #8a97b8;
  font-size: 24rpx;
}

.load-more {
  text-align: center;
  color: #8a97b8;
  padding: 24rpx 0;
}

/* 发帖弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(4, 8, 20, 0.7);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #101a38;
  border-radius: 36rpx 36rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 30rpx;
  text-align: center;
}

.sheet-input {
  margin-bottom: 24rpx;
}

.sheet .glass-btn {
  margin-top: 10rpx;
}

.picker {
  color: #8a97b8;
}