.learn-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 30rpx;
}

.learn-title {
  font-size: 38rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

/* ===== 单词答题（五选一） ===== */
.quiz-progress-track {
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.07);
  overflow: hidden;
  margin-bottom: 30rpx;
}

.quiz-progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #4f7cff, #22d3ee);
  transition: width 0.3s ease;
}

.quiz-card {
  position: relative;
  text-align: center;
  background: linear-gradient(160deg, rgba(79, 124, 255, 0.1), rgba(34, 211, 238, 0.04));
  border: 1rpx solid rgba(120, 150, 255, 0.25);
  border-radius: 28rpx;
  padding: 56rpx 30rpx 44rpx;
  margin-bottom: 30rpx;
}

.quiz-card.anim-a {
  animation: quiz-q-in 0.35s ease;
}

.quiz-card.anim-b {
  animation: quiz-q-in 0.35s ease;
}

@keyframes quiz-q-in {
  from { opacity: 0; transform: translateY(24rpx) scale(0.98); }
  to { opacity: 1; transform: none; }
}

.quiz-label {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #22d3ee;
  margin-bottom: 24rpx;
}

.quiz-word {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #dbe4f5;
  word-break: break-word;
}

.quiz-phonetic {
  color: #8a97b8;
  font-size: 26rpx;
  margin-top: 16rpx;
}

.quiz-voice {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  font-size: 28rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.06));
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.quiz-voice:active {
  border-color: rgba(34, 211, 238, 0.6);
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.quiz-option {
  display: flex;
  align-items: center;
  gap: 24rpx;
  font-size: 30rpx;
  color: #dbe4f5;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(120, 150, 255, 0.18);
  border-radius: 24rpx;
  padding: 26rpx 32rpx;
  transition: all 0.15s;
}

.quiz-option:active {
  border-color: rgba(34, 211, 238, 0.55);
  background: rgba(34, 211, 238, 0.05);
}

.quiz-opt-key {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  color: #a5b4fc;
  background: rgba(79, 124, 255, 0.16);
  border: 1rpx solid rgba(79, 124, 255, 0.25);
}

.quiz-opt-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.quiz-opt-mark {
  font-size: 30rpx;
  font-weight: 800;
  color: #34d399;
}

.quiz-opt-mark.wrong {
  color: #f87171;
}

.quiz-option.correct {
  border-color: rgba(52, 211, 153, 0.7);
  background: rgba(52, 211, 153, 0.1);
  animation: quiz-opt-correct 0.4s ease;
}

.quiz-option.correct .quiz-opt-key {
  color: #34d399;
  background: rgba(52, 211, 153, 0.15);
  border-color: rgba(52, 211, 153, 0.5);
}

@keyframes quiz-opt-correct {
  30% { transform: scale(1.02); }
}

.quiz-option.wrong {
  border-color: rgba(248, 113, 113, 0.7);
  background: rgba(248, 113, 113, 0.1);
  animation: quiz-opt-shake 0.4s ease;
}

.quiz-option.wrong .quiz-opt-key {
  color: #f87171;
  background: rgba(248, 113, 113, 0.15);
  border-color: rgba(248, 113, 113, 0.5);
}

@keyframes quiz-opt-shake {
  25% { transform: translateX(-12rpx); }
  75% { transform: translateX(12rpx); }
}

.quiz-option.dim {
  opacity: 0.4;
}

.quiz-feedback {
  text-align: center;
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  animation: quiz-q-in 0.25s ease;
}

.quiz-feedback.ok { color: #34d399; }
.quiz-feedback.bad { color: #f87171; }

.hud-item.hot .hud-value {
  color: #22d3ee;
}

/* ===== 语法 ===== */
.explain-card {
  background: rgba(129, 140, 248, 0.1);
  border: 1rpx solid rgba(129, 140, 248, 0.25);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 30rpx;
}

.explain-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #a5b4fc;
  margin-bottom: 16rpx;
}

.explain-text {
  color: #dbe4f5;
  line-height: 1.8;
}

.q-text {
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  margin: 30rpx 0;
}

.q-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(120, 150, 255, 0.2);
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 20rpx;
}

.q-option.correct {
  border-color: rgba(52, 211, 153, 0.7);
  background: rgba(52, 211, 153, 0.12);
}

.q-option.wrong {
  border-color: rgba(248, 113, 113, 0.7);
  background: rgba(248, 113, 113, 0.12);
}

.q-option.dim {
  opacity: 0.45;
}

.q-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(79, 124, 255, 0.2);
  color: #a5b4fc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 24rpx;
  flex-shrink: 0;
}

.feedback {
  text-align: center;
  margin: 24rpx 0;
  font-weight: 700;
}

.feedback.ok { color: #34d399; }
.feedback.bad { color: #f87171; }

/* ===== 口语 / 听力 ===== */
.sentence-order {
  text-align: center;
  color: #8a97b8;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.s-text {
  font-size: 52rpx;
  font-weight: 800;
  text-align: center;
  margin-bottom: 20rpx;
}

.s-trans {
  text-align: center;
  margin-bottom: 20rpx;
}

.s-tip {
  background: rgba(34, 211, 238, 0.08);
  border: 1rpx solid rgba(34, 211, 238, 0.2);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  color: #67e8f9;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.self-label {
  margin-bottom: 16rpx;
}

.self-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.self-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 24rpx;
  font-weight: 700;
}

.self-btn.ok {
  background: rgba(52, 211, 153, 0.15);
  border: 1rpx solid rgba(52, 211, 153, 0.4);
  color: #34d399;
}

.self-btn.mid {
  background: rgba(251, 191, 36, 0.15);
  border: 1rpx solid rgba(251, 191, 36, 0.4);
  color: #fbbf24;
}

.self-btn.bad {
  background: rgba(248, 113, 113, 0.15);
  border: 1rpx solid rgba(248, 113, 113, 0.4);
  color: #f87171;
}

.score-big {
  font-size: 70rpx;
  font-weight: 800;
  text-align: center;
  margin: 20rpx 0;
  color: #22d3ee;
}

.score-big.c-ok { color: #34d399; }
.score-big.c-mid { color: #fbbf24; }
.score-big.c-bad { color: #f87171; }

.play-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin: 20rpx auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #04122e;
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
  box-shadow: 0 0 52rpx rgba(245, 158, 11, 0.4);
}

.listen-hint {
  text-align: center;
  margin-bottom: 20rpx;
}

.hint-btn {
  text-align: center;
  color: #8a97b8;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.answer-box {
  background: rgba(255, 255, 255, 0.04);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.disabled-btn {
  opacity: 0.5;
}

/* ===== 对话 ===== */
.chat-area {
  margin-bottom: 30rpx;
}

.bubble-row {
  display: flex;
  margin-bottom: 20rpx;
}

.bubble-row.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  border-radius: 24rpx;
  padding: 20rpx 26rpx;
}

.ai-bubble {
  background: rgba(79, 124, 255, 0.14);
  border: 1rpx solid rgba(79, 124, 255, 0.25);
  border-bottom-left-radius: 6rpx;
}

.user-bubble {
  background: rgba(236, 72, 153, 0.14);
  border: 1rpx solid rgba(236, 72, 153, 0.3);
  border-bottom-right-radius: 6rpx;
}

.bubble-score {
  margin-top: 10rpx;
  font-weight: 700;
  font-size: 24rpx;
}

.bubble-score.ok { color: #34d399; }
.bubble-score.bad { color: #f87171; }

.answer-area {
  background: rgba(236, 72, 153, 0.06);
  border: 1rpx solid rgba(236, 72, 153, 0.22);
  border-radius: 24rpx;
  padding: 28rpx;
}

.answer-trans {
  font-size: 32rpx;
  font-weight: 700;
  margin: 16rpx 0 24rpx;
}

.type-row {
  display: flex;
  gap: 16rpx;
}

.flex-input {
  flex: 1;
}

.submit-btn {
  padding: 0 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
  color: #04122e;
  font-weight: 700;
  display: flex;
  align-items: center;
}

/* ===== 结算 ===== */
.result {
  padding-top: 8vh;
  text-align: center;
}

.result-stars {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.star.big {
  font-size: 90rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: 800;
  margin: 30rpx 0 16rpx;
  color: #22d3ee;
}

.result-score {
  color: #8a97b8;
  margin-bottom: 40rpx;
}

.ach-box {
  background: rgba(251, 191, 36, 0.08);
  border: 1rpx solid rgba(251, 191, 36, 0.25);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 40rpx;
}

.ach-title {
  font-weight: 700;
  color: #fbbf24;
  margin-bottom: 16rpx;
}

.ach-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.ach-icon {
  font-size: 34rpx;
}

.ph {
  color: #8a97b8;
}