<view class="page" wx:if="{{user}}">
  <view class="page-title">个人中心</view>
  <view class="page-subtitle">管理资料与学习偏好</view>

  <view class="card">
    <view class="profile-head">
      <view class="profile-avatar">{{user.avatar}}</view>
      <view>
        <view class="profile-nickname">{{user.nickname}}</view>
        <view class="text-muted text-sm">@{{user.username}}</view>
      </view>
    </view>

    <view class="form-label">昵称</view>
    <view class="input">
      <input placeholder="设置你的昵称" placeholder-class="ph" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <view class="form-label">学习语种（影响每日单词与推荐）</view>
    <view class="lang-checks">
      <view
        class="lang-check {{selected.indexOf(item.code) >= 0 ? 'checked' : ''}}"
        wx:for="{{languages}}"
        wx:key="code"
        bindtap="toggleLang"
        data-code="{{item.code}}"
      >{{item.icon}} {{item.nameCn}}</view>
    </view>

    <view class="glass-btn primary" bindtap="save">保存修改</view>
    <view class="glass-btn" bindtap="goAchievements">🏆 成就殿堂</view>
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>