.post-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.post-avatar {
  font-size: 56rpx;
}

.post-author {
  font-weight: 600;
  font-size: 26rpx;
}

.post-lang {
  margin-left: auto;
}

.post-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.post-body {
  line-height: 1.8;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.like-btn {
  text-align: center;
  padding: 16rpx 0;
  border-top: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 32rpx;
  color: #8a97b8;
  font-size: 28rpx;
}

.like-btn.liked {
  color: #f87171;
}

.comment {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx dashed rgba(120, 150, 255, 0.14);
}

.comment-avatar {
  font-size: 44rpx;
}

.comment-body {
  flex: 1;
}

.comment-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.comment-author {
  font-weight: 600;
  font-size: 24rpx;
}

.comment-content {
  font-size: 26rpx;
  line-height: 1.6;
}

.comment-input-row {
  display: flex;
  gap: 16rpx;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #101a38;
  border-top: 1rpx solid rgba(120, 150, 255, 0.14);
}

.flex-input {
  flex: 1;
}

.submit-btn {
  padding: 0 32rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
  color: #04122e;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.ph {
  color: #8a97b8;
}