.head {
  display: flex;
  gap: 28rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.head-cover {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  background: linear-gradient(135deg, rgba(79, 124, 255, 0.22), rgba(34, 211, 238, 0.1));
  border: 1rpx solid rgba(120, 150, 255, 0.25);
  border-radius: 24rpx;
  flex-shrink: 0;
}

.head-info {
  flex: 1;
  min-width: 0;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
}

.head-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 14rpx 0;
}

.head-desc {
  font-size: 24rpx;
  color: #8a97b8;
  margin-bottom: 16rpx;
}

.progress-outer {
  height: 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #4f7cff, #22d3ee);
}

.unit {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.unit-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.unit-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
  color: #04122e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}

.unit-name {
  font-weight: 700;
  font-size: 30rpx;
}

.lesson {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  background: rgba(255, 255, 255, 0.02);
}

.lesson-emoji {
  font-size: 40rpx;
}

.lesson-title {
  flex: 1;
  font-weight: 600;
  font-size: 27rpx;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-status {
  font-size: 22rpx;
  color: #8a97b8;
}

.lesson-status.s-COMPLETED {
  color: #34d399;
}

.lesson-status.s-IN_PROGRESS {
  color: #fbbf24;
}

.lesson-btn {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #04122e;
  font-weight: 700;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
}