<view class="page">
  <view class="page-title">关卡地图</view>
  <view class="page-subtitle">多语种 · CEFR 分级，从入门到进阶</view>

  <!-- 语种切换 -->
  <scroll-view scroll-x class="lang-tabs">
    <view class="lang-tab {{activeLang === '' ? 'active' : ''}}" bindtap="switchTab" data-lang="">{{i18n.all}}</view>
    <view
      class="lang-tab {{activeLang === item.code ? 'active' : ''}}"
      wx:for="{{languages}}"
      wx:key="code"
      bindtap="switchTab"
      data-lang="{{item.code}}"
    >{{item.icon}} {{item.nameCn}}<text wx:if="{{item.vipOnly}}" class="tab-vip">👑</text></view>
  </scroll-view>

  <!-- 课程卡片 -->
  <view
    class="course-card {{item.vipOnly ? 'vip-course' : ''}}"
    wx:for="{{courses}}"
    wx:key="id"
    bindtap="goDetail"
    data-id="{{item.id}}"
    data-viponly="{{item.vipOnly ? 1 : 0}}"
  >
    <view class="course-cover {{item.vipOnly ? 'vip-cover' : ''}}">
      {{item.cover}}
      <view wx:if="{{item.vipOnly}}" class="vip-ribbon">👑 {{i18n.vipOnly}}</view>
    </view>
    <view class="course-body">
      <view class="course-title">
        {{item.title}}
        <text wx:if="{{item.ttsApproximate}}" class="approx-tag">近似发音</text>
      </view>
      <view class="course-meta">
        <text class="tag">{{item.level}} · {{item.levelName}}</text>
        <text class="text-muted text-sm">{{item.lessonCount}} 关</text>
      </view>
      <view class="course-desc">{{item.description}}</view>
      <view class="progress-outer">
        <view class="progress-inner" style="width: {{item.progressPercent}}%"></view>
      </view>
      <view class="text-muted text-sm progress-text">已完成 {{item.completedLessons}} / {{item.lessonCount}} 关</view>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{!loading && !courses.length}}">暂无课程</view>
</view>
