.lang-tabs {
  white-space: nowrap;
  margin-bottom: 28rpx;
}

.lang-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: #8a97b8;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
}

.lang-tab.active {
  color: #04122e;
  background: linear-gradient(135deg, #4f7cff, #22d3ee);
  border-color: transparent;
  font-weight: 700;
}

.tab-vip {
  font-size: 20rpx;
  margin-left: 4rpx;
}

.course-card.vip-course {
  border-color: rgba(255, 184, 79, 0.3);
}

.course-cover.vip-cover {
  background: linear-gradient(135deg, rgba(255, 184, 79, 0.24), rgba(255, 154, 60, 0.08));
  border-color: rgba(255, 184, 79, 0.35);
}

.vip-ribbon {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #2b1a00;
  background: linear-gradient(90deg, #ffb84f, #ff9a3c);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

.course-cover {
  position: relative;
}

.approx-tag {
  font-size: 18rpx;
  font-weight: 400;
  color: #8a97b8;
  border: 1rpx solid rgba(120, 150, 255, 0.25);
  border-radius: 12rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
}

.course-card {
  display: flex;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.course-cover {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(135deg, rgba(79, 124, 255, 0.22), rgba(34, 211, 238, 0.08));
  border: 1rpx solid rgba(120, 150, 255, 0.22);
  border-radius: 20rpx;
  flex-shrink: 0;
}

.course-body {
  flex: 1;
  min-width: 0;
}

.course-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.course-desc {
  font-size: 24rpx;
  color: #8a97b8;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-outer {
  height: 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #4f7cff, #22d3ee);
}

.progress-text {
  margin-top: 10rpx;
}