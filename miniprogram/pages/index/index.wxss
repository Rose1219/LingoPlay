.mini-home {
  padding-top: 6vh;
}

/* 每日单词卡 */
.daily-card {
  border: 1rpx solid rgba(120, 150, 255, 0.22);
  border-radius: 40rpx;
  padding: 44rpx 44rpx 36rpx;
  margin-bottom: 28rpx;
  text-align: center;
}

.daily-card.revealed {
  border-color: rgba(79, 124, 255, 0.45);
}

.daily-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.daily-label {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #22d3ee;
}

.daily-lang {
  font-size: 22rpx;
  color: #8a97b8;
}

.daily-word {
  font-size: 92rpx;
  font-weight: 800;
  color: #22d3ee;
  line-height: 1.15;
}

.daily-phonetic {
  color: #8a97b8;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.daily-meaning {
  margin-top: 30rpx;
  font-size: 32rpx;
  color: #dbe4f5;
  min-height: 44rpx;
}

.daily-meaning.hidden {
  color: #8a97b8;
  font-size: 24rpx;
}

.example-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.example-text {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.example-voice {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.06) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.28);
}

.example-trans {
  color: #8a97b8;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 玻璃按钮组 */
.glass-tools {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.glass-tools .tool {
  flex: 1;
  margin-bottom: 0;
  font-size: 28rpx;
}

.glass-tools .disabled {
  opacity: 0.5;
}

/* 游戏工坊 */
.section-title {
  font-size: 34rpx;
  font-weight: 800;
  margin: 48rpx 0 24rpx;
}

.game-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.game-card {
  width: calc(33.33% - 14rpx);
  text-align: center;
  padding: 30rpx 10rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(120, 150, 255, 0.14);
}

.game-emoji {
  font-size: 60rpx;
  display: block;
  margin-bottom: 12rpx;
}

.game-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #dbe4f5;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 20rpx;
  color: #8a97b8;
}
/* 翻译 & VIP 快捷入口 */
.quick-entries {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.quick-entry {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(120, 150, 255, 0.22);
  border-radius: 24rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.04);
}

.quick-entry.quick-vip {
  border-color: rgba(255, 184, 79, 0.3);
  background: rgba(255, 184, 79, 0.06);
}

.quick-emoji {
  font-size: 40rpx;
}

.quick-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #e8ecf8;
}

.quick-sub {
  display: block;
  font-size: 20rpx;
  color: #8a97b8;
  margin-top: 2rpx;
}
